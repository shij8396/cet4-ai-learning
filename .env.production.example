# Production Environment Variables Template
# DO NOT commit actual values.

NODE_ENV="production"
DATABASE_URL="mysql+pymysql://USER:PASSWORD@HOST:3306/cet4_learning"
REDIS_URL="redis://HOST:6379/0"
JWT_SECRET_KEY="replace-with-a-long-random-secret"
CORS_ORIGINS="https://your-domain.com"
APP_TIMEZONE="Asia/Shanghai"

NEXT_PUBLIC_API_BASE_URL="https://api.your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_NAME="CET4 AI Learning"
NEXT_PUBLIC_ENABLE_PWA="true"
NEXT_PUBLIC_ENABLE_AI_COACH="true"
NEXT_PUBLIC_ENABLE_DICTATION="true"
NEXT_PUBLIC_ENABLE_WRITING="true"
NEXT_PUBLIC_ENABLE_READING="true"

AI_DEFAULT_PROVIDER="openai"
AI_DEFAULT_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
AI_RATE_LIMIT_PER_HOUR="20"
AI_RATE_LIMIT_PER_DAY="100"
