# CET4 AI Learning - Environment Variables
# Copy this file to .env.local for local development.
# Do not commit .env, .env.local, or production secrets.

# FastAPI backend
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
DATABASE_URL="mysql+pymysql://cet4:password@localhost:3306/cet4_learning"
REDIS_URL="redis://localhost:6379/0"
JWT_SECRET_KEY="replace-with-a-long-random-secret"
MYSQL_ROOT_PASSWORD="rootpassword"
MYSQL_PASSWORD="password"
CORS_ORIGINS="http://localhost:3000"
APP_TIMEZONE="Asia/Shanghai"

# AI Provider
# AI features degrade gracefully when no API key is configured.
AI_DEFAULT_PROVIDER="openai"
AI_DEFAULT_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# AI Rate Limiting
AI_RATE_LIMIT_PER_HOUR="20"
AI_RATE_LIMIT_PER_DAY="100"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CET4 AI Learning"

# Feature Flags
NEXT_PUBLIC_ENABLE_PWA="true"
NEXT_PUBLIC_ENABLE_AI_COACH="true"
NEXT_PUBLIC_ENABLE_DICTATION="true"
NEXT_PUBLIC_ENABLE_WRITING="true"
NEXT_PUBLIC_ENABLE_READING="true"
